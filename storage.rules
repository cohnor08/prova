rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Chat photo/video attachments. Any signed-in user may read and upload;
    // uploads are capped at 150 MB (fits ~2 min of 720p proof video) and must
    // be an image or video.
    //
    // Proof-of-practice clips live at chatMedia/proof_{uid}/… and are LOCKED to
    // their owner here: only the student may upload or list/read them through
    // the rules. The teacher watches the clip via the tokened download URL that
    // the app stores on the task (getDownloadURL), which doesn't go through
    // these rules — so nothing breaks, but arbitrary signed-in users can no
    // longer browse other students' practice videos.
    match /chatMedia/{chatId}/{fileName} {
      allow read: if request.auth != null
        && (!chatId.matches('proof_.*') || chatId == 'proof_' + request.auth.uid);
      allow write: if request.auth != null
        && (!chatId.matches('proof_.*') || chatId == 'proof_' + request.auth.uid)
        && request.resource.size < 150 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*'));
    }

    // Files a teacher attaches to a task: sheet music and tabs as PDFs,
    // backing tracks and recordings as audio, plus photos and video. Written
    // only by the teacher, under their own uid, so nobody can drop files into
    // someone else's folder. Students open them through the tokened download
    // URL saved on the task, the same way they open everything else here.
    // 300 MB matches TASK_FILE_MAX_BYTES in src/lib/attachments.js — about
    // half an hour of WAV, or hours of MP3.
    match /taskFiles/{ownerUid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.size <= 300 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('audio/.*')
            || request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*'));
    }
  }
}
